          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('same-day request returns business result', () => pm.expect([201, 400, 409]).to.include(pm.response.code));",
                "const json = pm.response.json();",
                "if (pm.response.code === 201) { pm.test('same-day booking allowed', () => pm.expect(json.data.status).to.eql('CONFIRMED')); }",
                "if (pm.response.code !== 201) { pm.test('same-day failure is availability/data dependent', () => pm.expect(json.success).to.eql(false)); }"
