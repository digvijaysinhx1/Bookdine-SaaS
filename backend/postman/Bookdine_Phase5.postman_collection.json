                "pm.test('returns 200', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "const slot = json.data.slots.find((item) => item.time === pm.environment.get('doubleBookingSlot'));",
                "pm.test('reserved slot is represented by availability engine', () => pm.expect(slot).to.not.eql(undefined));"
              ]
            }
          }]
        }
