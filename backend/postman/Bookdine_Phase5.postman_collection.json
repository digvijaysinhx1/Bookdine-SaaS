{
  "info": {
    "name": "Bookdine Phase 5 - Reservations",
    "description": "Phase 5 backend-only Postman collection for reservation engine testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const pad = (value) => String(value).padStart(2, '0');",
          "const formatDate = (date) => `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;",
          "const addDays = (days) => { const date = new Date(); date.setHours(0, 0, 0, 0); date.setDate(date.getDate() + days); return formatDate(date); };",
          "const roundToNextSlot = () => { const now = new Date(); let minutes = now.getHours() * 60 + now.getMinutes(); minutes = Math.ceil(minutes / 30) * 30 + 30; if (minutes > 22 * 60) { minutes = 20 * 60; } return `${pad(Math.floor(minutes / 60))}:${pad(minutes % 60)}`; };",
          "if (!pm.environment.get('phase5RunId')) { pm.environment.set('phase5RunId', String(Date.now()).slice(-6)); }",
          "const runId = pm.environment.get('phase5RunId');",
          "pm.environment.set('phase5Today', addDays(0));",
          "pm.environment.set('phase5Tomorrow', addDays(1));",
          "pm.environment.set('phase5Plus7', addDays(7));",
          "if (!pm.environment.get('availableDate')) { pm.environment.set('availableDate', addDays(7)); }",
          "if (!pm.environment.get('doubleBookingDate')) { pm.environment.set('doubleBookingDate', addDays(7)); }",
          "if (!pm.environment.get('sameDaySlot')) { pm.environment.set('sameDaySlot', roundToNextSlot()); }",
          "if (pm.environment.get('phoneNumber') === '+919000005001') { pm.environment.set('phoneNumber', `+919000${runId}`); }",
          "if (pm.environment.get('activeLimitPhone') === '+919000005777') { pm.environment.set('activeLimitPhone', `+919777${runId}`); }",
          "if (pm.environment.get('doubleBookingPhone1') === '+919000005881') { pm.environment.set('doubleBookingPhone1', `+919881${runId}`); }",
          "if (pm.environment.get('doubleBookingPhone2') === '+919000005882') { pm.environment.set('doubleBookingPhone2', `+919882${runId}`); }"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminEmail", "value": "restaurant.admin@example.com" },
    { "key": "adminPassword", "value": "ChangeMe123!" },
    { "key": "accessToken", "value": "" },
    { "key": "reservationId", "value": "" },
    { "key": "cancellableReservationId", "value": "" },
    { "key": "tenantIsolationReservationId", "value": "1" }
  ],
  "item": [
    {
      "name": "01 - Authentication Setup",
      "item": [
        {
          "name": "LOGIN - Restaurant User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('returns 200', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('login succeeds', () => pm.expect(json.success).to.eql(true));",
                "pm.test('returns access token', () => pm.expect(json.data.access_token).to.be.a('string'));",
                "pm.environment.set('accessToken', json.data.access_token);",
                "pm.collectionVariables.set('accessToken', json.data.access_token);"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "02 - Core Reservation APIs",
      "item": [
        {
          "name": "RESERVATION - Create Reservation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/reservations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guest_name\": \"{{guestName}}\",\n  \"phone_number\": \"{{phoneNumber}}\",\n  \"email\": \"{{email}}\",\n  \"guests\": {{guests}},\n  \"date\": \"{{availableDate}}\",\n  \"slot\": \"{{availableSlot}}\",\n  \"source\": \"{{reservationSource}}\",\n  \"special_notes\": \"Phase 5 Postman create reservation test\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('returns 201', () => pm.response.to.have.status(201));",
                "const json = pm.response.json();",
                "pm.test('request succeeds', () => pm.expect(json.success).to.eql(true));",
                "pm.test('reservation is confirmed', () => pm.expect(json.data.status).to.eql('CONFIRMED'));",
                "pm.test('required fields returned', () => { ['id', 'guest_name', 'phone_number', 'email', 'guests', 'date', 'slot', 'source', 'status'].forEach((field) => pm.expect(json.data).to.have.property(field)); });",
                "pm.environment.set('reservationId', json.data.id);",
                "pm.collectionVariables.set('reservationId', json.data.id);"
              ]
            }
          }]
        },
        {
          "name": "RESERVATION - Get All Reservations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/reservations"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('returns 200', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('request succeeds', () => pm.expect(json.success).to.eql(true));",
                "pm.test('returns reservations array', () => pm.expect(json.data).to.be.an('array'));"
              ]
            }
          }]
        },
        {
          "name": "RESERVATION - Get Reservation By Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('returns 200', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('request succeeds', () => pm.expect(json.success).to.eql(true));",
                "pm.test('returns selected reservation', () => pm.expect(String(json.data.id)).to.eql(String(pm.environment.get('reservationId'))));"
              ]
            }
          }]
        },
        {
          "name": "RESERVATION - Change Status To Seated",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SEATED\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('returns 200', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('status changed to SEATED', () => pm.expect(json.data.status).to.eql('SEATED'));"
              ]
            }
          }]
        },
        {
          "name": "RESERVATION - Change Status To Completed",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('returns 200', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('status changed to COMPLETED', () => pm.expect(json.data.status).to.eql('COMPLETED'));"
              ]
            }
          }]
        }
      ]
    },
