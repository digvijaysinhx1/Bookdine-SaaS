              "mode": "raw",
              "raw": "{\n  \"guest_name\": \"Unauthorized Guest\",\n  \"phone_number\": \"+919111111111\",\n  \"email\": \"unauthorized@example.com\",\n  \"guests\": 2,\n  \"date\": \"{{availableDate}}\",\n  \"slot\": \"{{availableSlot}}\",\n  \"source\": \"Walk In\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('returns 401', () => pm.response.to.have.status(401));",
                "pm.test('token required code', () => pm.expect(pm.response.json().error.code).to.eql('TOKEN_REQUIRED'));"
              ]
            }
          }]
        },
        {
          "name": "RESERVATION - Tenant Isolation Query",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/reservations?tenant_id={{restaurantBTenantId}}"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('returns 403', () => pm.response.to.have.status(403));",
                "pm.test('tenant forbidden code', () => pm.expect(pm.response.json().error.code).to.eql('TENANT_FORBIDDEN'));"
              ]
            }
          }]
        },
        {
          "name": "RESERVATION - Tenant Isolation Header",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "x-tenant-id", "value": "{{restaurantBTenantId}}" }
            ],
            "url": "{{baseUrl}}/api/reservations/{{tenantIsolationReservationId}}"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('returns 403', () => pm.response.to.have.status(403));",
                "pm.test('tenant forbidden code', () => pm.expect(pm.response.json().error.code).to.eql('TENANT_FORBIDDEN'));"
              ]
            }
          }]
        }
      ]
    }
  ]
