                "const json = pm.response.json();",
                "pm.test('availability engine returns slots', () => pm.expect(json.data.slots).to.be.an('array'));",
                "pm.test('locked duration and interval', () => { pm.expect(json.data.reservation_duration_minutes).to.eql(90); pm.expect(json.data.slot_interval_minutes).to.eql(30); });"
              ]
            }
          }]
