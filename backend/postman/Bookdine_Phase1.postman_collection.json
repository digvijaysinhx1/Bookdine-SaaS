{
  "info": {
    "name": "Bookdine Phase 1 - Backend Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminEmail", "value": "restaurant.admin@example.com" },
    { "key": "adminPassword", "value": "ChangeMe123!" },
    { "key": "managerEmail", "value": "manager@example.com" },
    { "key": "managerPassword", "value": "ChangeMe123!" },
    { "key": "staffEmail", "value": "staff@example.com" },
    { "key": "staffPassword", "value": "ChangeMe123!" },
    { "key": "inactiveEmail", "value": "inactive@example.com" },
    { "key": "inactivePassword", "value": "ChangeMe123!" },
    { "key": "invalidEmail", "value": "not-an-email" },
    { "key": "wrongPassword", "value": "WrongPass123!" },
    { "key": "restaurantBTenantId", "value": "replace-with-restaurant-b-tenant-id" },
    { "key": "expiredToken", "value": "replace-with-expired-jwt" },
    { "key": "accessToken", "value": "" },
    { "key": "managerToken", "value": "" },
    { "key": "staffToken", "value": "" }
  ],
  "item": [
    {
      "name": "LOGIN - Successful Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('returns 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.test('returns access token', () => pm.expect(json.data.access_token).to.be.a('string'));",
            "pm.test('returns RESTAURANT_ADMIN', () => pm.expect(json.data.user.role).to.eql('RESTAURANT_ADMIN'));",
            "pm.collectionVariables.set('accessToken', json.data.access_token);"
          ]
        }
      }]
    },
    {
      "name": "LOGIN - Invalid Email",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{invalidEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('returns 400', () => pm.response.to.have.status(400));",
            "pm.test('invalid email code', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_EMAIL'));"
          ]
        }
      }]
    },
    {
      "name": "LOGIN - Invalid Password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{wrongPassword}}\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('returns 401', () => pm.response.to.have.status(401));",
            "pm.test('invalid credentials code', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_CREDENTIALS'));"
          ]
        }
      }]
    },
    {
      "name": "LOGIN - Inactive Account",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{inactiveEmail}}\",\n  \"password\": \"{{inactivePassword}}\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('returns 403', () => pm.response.to.have.status(403));",
            "pm.test('inactive account code', () => pm.expect(pm.response.json().error.code).to.eql('ACCOUNT_INACTIVE'));"
          ]
        }
      }]
    },
    {
      "name": "LOGIN - Logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/auth/logout"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('returns 200', () => pm.response.to.have.status(200));",
            "pm.test('logout succeeds', () => pm.expect(pm.response.json().success).to.eql(true));"
          ]
        }
      }]
    },
    {
      "name": "TOKEN - Expired Token",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{expiredToken}}" }],
        "url": "{{baseUrl}}/api/reservations"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('returns 401', () => pm.response.to.have.status(401));",
            "pm.test('expired token code', () => pm.expect(pm.response.json().error.code).to.eql('TOKEN_EXPIRED'));"
          ]
        }
      }]
    },
    {
      "name": "AUTH - Unauthorized Access",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/reservations"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('returns 401', () => pm.response.to.have.status(401));",
            "pm.test('token required code', () => pm.expect(pm.response.json().error.code).to.eql('TOKEN_REQUIRED'));"
          ]
        }
      }]
    },
    {
      "name": "TENANT - Restaurant A Attempts Restaurant B Data",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/reservations?tenant_id={{restaurantBTenantId}}"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('returns 403', () => pm.response.to.have.status(403));",
            "pm.test('tenant forbidden code', () => pm.expect(pm.response.json().error.code).to.eql('TENANT_FORBIDDEN'));"
          ]
        }
      }]
    },
    {
      "name": "ROLE - RESTAURANT_ADMIN Access",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/reservations"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('admin can access protected tenant route', () => pm.response.to.have.status(200));"
          ]
        }
      }]
    },
    {
      "name": "ROLE - MANAGER Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{managerEmail}}\",\n  \"password\": \"{{managerPassword}}\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('manager login returns 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.test('returns MANAGER', () => pm.expect(json.data.user.role).to.eql('MANAGER'));",
            "pm.collectionVariables.set('managerToken', json.data.access_token);"
          ]
        }
      }]
    },
    {
      "name": "ROLE - MANAGER Access",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
        "url": "{{baseUrl}}/api/reservations"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('manager can access protected tenant route', () => pm.response.to.have.status(200));"
          ]
        }
      }]
    },
    {
      "name": "ROLE - STAFF Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{staffPassword}}\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('staff login returns 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.test('returns STAFF', () => pm.expect(json.data.user.role).to.eql('STAFF'));",
            "pm.collectionVariables.set('staffToken', json.data.access_token);"
          ]
        }
      }]
    },
    {
      "name": "ROLE - STAFF Access",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
        "url": "{{baseUrl}}/api/reservations"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('staff can access protected tenant route', () => pm.response.to.have.status(200));"
          ]
        }
      }]
    }
  ]
}
